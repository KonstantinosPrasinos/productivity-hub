{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Taskflow",
  "version": "1.0.0",
  "identifier": "com.taskflow.kprasinos.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://192.168.1.24:5173",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Taskflow",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
